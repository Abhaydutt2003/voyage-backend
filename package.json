  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.804.0",
    "@aws-sdk/cloudfront-signer": "^3.821.0",
    "@aws-sdk/lib-storage": "^3.804.0",
    "@aws-sdk/s3-request-presigner": "^3.835.0",
    "@prisma/client": "^6.7.0",
    "@terraformer/wkt": "^2.2.1",
    "@types/pdfkit": "^0.14.0",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pdfkit-table": "^0.1.99",
